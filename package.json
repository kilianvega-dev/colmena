{
  "name": "claude-colmena",
  "version": "0.1.0",
  "description": "Local dashboard to run several Claude Code sessions side by side and see which one needs you",
  "type": "module",
  "bin": {
    "claude-colmena": "lib/index.js"
  },
  "files": [
    "lib",
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "test": "vitest run",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node -e \"require('fs').copyFileSync('server/hook-relay.cjs','lib/hook-relay.cjs')\"",
    "prepack": "npm run build && npm run build:server",
    "start": "vite build && node server/index.ts",
    "dev": "concurrently -n server,web \"node --env-file=.env.dev --watch server/index.ts\" \"vite\""
  },
  "keywords": [
    "claude",
    "claude-code",
    "terminal",
    "dashboard",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kilianvega-dev/colmena.git"
  },
  "homepage": "https://github.com/kilianvega-dev/colmena#readme",
  "bugs": "https://github.com/kilianvega-dev/colmena/issues",
  "license": "MIT"
}
